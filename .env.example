# AI provider (server-side only, never expose with NEXT_PUBLIC_ prefix)
BANGUNWEB_BASE_URL=https://router.bangunweb.com/v1
BANGUNWEB_API_KEY=
BANGUNWEB_MODEL=bw-swift

# Optional: separate models for image and audio generation
BANGUNWEB_IMAGE_MODEL=bwr-image
BANGUNWEB_AUDIO_MODEL=kokoro
BANGUNWEB_AUDIO_VOICE=af_heart

# Workspace persistence.
# fs     -> local filesystem (great for local dev / a Node host)
# blob   -> Vercel Blob, required for persistence on serverless
AOMI_STORAGE=fs
BLOB_READ_WRITE_TOKEN=

# Where the fs driver keeps data (defaults to ./.aomi-data/workspace)
AOMI_WORKSPACE_DIR=

# Agent guardrails
AOMI_MAX_STEPS=14
AOMI_RATE_LIMIT_PER_MIN=30

# Object storage (required for persistence on Vercel: set AOMI_STORAGE=s3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=aomi
